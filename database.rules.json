{
  "rules": {
    ".read": false,
    ".write": false,

    "experiences": {
      // Anyone can read the full catalog.
      ".read": true,

      "$experienceId": {
        // Anyone can create a new experience.
        ".write": "!data.exists()",

        // Creator can update or delete their own experience.
        ".write": "data.child('createdByDeviceId').val() === auth.uid || !data.exists()",

        // Fallback: allow writes without auth (no Firebase Auth yet).
        // TODO: tighten once Firebase Auth is added.
        ".write": true
      }
    },

    "sessions": {
      "$roomCode": {
        ".read": true,
        ".write": "!data.exists()",

        "status": {
          ".write": "data.parent().exists()"
        },
        "startAt": {
          ".write": "data.parent().exists()"
        },

        "participants": {
          "$deviceId": {
            ".read": true,
            ".write": "data.parent().parent().exists() || !data.exists()"
          }
        },

        "roles": {
          "$roleId": {
            ".read": true,
            "takenBy": {
              ".write": "data.parent().parent().parent().child('status').val() === 'lobby'"
            }
          }
        }
      }
    }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,

    "experiences": {
      // Anyone can read the full catalog.
      ".read": true,

      "$experienceId": {
        // Allow all writes until Firebase Auth is added.
        // TODO: tighten to creator-only once auth is implemented.
        ".write": true
      }
    },

    "sessions": {
      "$roomCode": {
        ".read": true,
        ".write": "!data.exists()",

        "status": {
          ".write": "data.parent().exists()"
        },
        "startAt": {
          ".write": "data.parent().exists()"
        },
        "pausedAt": {
          ".write": "data.parent().exists()"
        },

        "participants": {
          "$deviceId": {
            ".read": true,
            ".write": "data.parent().parent().exists() || !data.exists()"
          }
        },

        "roles": {
          "$roleId": {
            ".read": true
          }
        }
      }
    }
  }
}
